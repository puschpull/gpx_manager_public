# ============================================================
#  GPX Manager — konfigurace (.env)
#  Zkopíruj tento soubor jako .env a vyplň své údaje.
#  NIKDY nesdílej soubor .env — obsahuje citlivá data!
# ============================================================

# ── Databáze ────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=gpx_manager
DB_USER=root
DB_PASS=

# ── Admin účet ──────────────────────────────────────────────
# Uživatelské jméno pro přihlášení
ADMIN_USER=admin

# Heslo jako bcrypt hash.
# Vygeneruj spuštěním setup.php NEBO příkazem v terminálu:
#   php -r "echo password_hash('tvoje_heslo', PASSWORD_DEFAULT);"
ADMIN_PASS_HASH=

# ── Admin IP adresy ──────────────────────────────────────────
# Čárkou oddělený seznam IP adres, ze kterých je povolen admin přístup.
# 127.0.0.1 a ::1 (localhost) jsou vždy povoleny automaticky.
# Zjisti svou veřejnou IP: https://www.whatismyip.com/
ADMIN_IPS=127.0.0.1,::1

# ── API klíče (volitelné) ────────────────────────────────────
# Bez API klíčů funguje aplikace s OpenStreetMap mapami (zdarma).
# Pro lepší mapové podklady si zaregistruj vlastní klíče:

# Thunderforest (turistické mapy) — https://www.thunderforest.com/
TF_API_KEY=

# Mapy.cz (česká letecká mapa) — https://developer.mapy.cz/
MAPYCOM_API_KEY=

# Mapillary (fotky na trasách z ulice) — https://www.mapillary.com/developer
MAPILLARY_TOKEN=
