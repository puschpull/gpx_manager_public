# ============================================================
#  GPX Manager — konfigurace (.env)
#  Zkopíruj tento soubor jako .env a vyplň své údaje.
#  NIKDY nesdílej soubor .env — obsahuje citlivá data!
# ============================================================

# ── Databáze ────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=gpx_manager
DB_USER=root
DB_PASS=

# ── Admin účet ──────────────────────────────────────────────
# Uživatelské jméno pro přihlášení
ADMIN_USER=admin

# Heslo jako bcrypt hash.
# Vygeneruj spuštěním setup.php NEBO příkazem v terminálu:
#   php -r "echo password_hash('tvoje_heslo', PASSWORD_DEFAULT);"
ADMIN_PASS_HASH=

# ── Admin IP adresy ──────────────────────────────────────────
# Čárkou oddělený seznam IP adres, ze kterých je admin bez hesla.
# Platí JEN na vývojovém PC (APP_ENV=local, soubor .gpx-local); localhost
# je tam povolen vždy. Na produkci se ignoruje — admin jen po přihlášení
# heslem („Zapamatovat na tomto zařízení“ drží přihlášení 30 dní).
ADMIN_IPS=127.0.0.1,::1

# ── API klíče (volitelné) ────────────────────────────────────
# Bez API klíčů funguje aplikace s OpenStreetMap mapami (zdarma).
# Pro lepší mapové podklady si zaregistruj vlastní klíče:

# Thunderforest (turistické mapy) — https://www.thunderforest.com/
TF_API_KEY=

# Mapy.cz (česká letecká mapa) — https://developer.mapy.cz/
MAPYCOM_API_KEY=

# Mapillary (fotky na trasách z ulice) — https://www.mapillary.com/developer
MAPILLARY_TOKEN=

# Cestopis (text výletu psaný AI) — https://platform.claude.com (placené podle
# spotřeby, jeden cestopis zhruba $0.05–0.35). Funkci je navíc potřeba zapnout
# v Administraci → Volitelné funkce. Hodnota bez uvozovek.
ANTHROPIC_API_KEY=
